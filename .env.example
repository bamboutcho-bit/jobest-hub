# =============================================================================
# AutoHunt Pro & Freelance Engine — Environment Configuration Template
# Copy this file to .env and customize your credentials.
# =============================================================================

# Admin Account (the platform admin — synced on startup)
ADMIN_EMAIL=admin@autohunt.internal
ADMIN_PASSWORD=REPLACE_WITH_YOUR_ADMIN_PASSWORD

# AI & LLM Provider Configuration
AI_PROVIDER=ollama
AI_FALLBACK_PROVIDERS=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
AI_REQUEST_TIMEOUT_SECONDS=120
AI_TRANSIENT_RETRY_COUNT=1
AI_TRANSIENT_RETRY_DELAY_SECONDS=2
MAX_AI_CALLS_PER_DAY=150
MAX_AI_CALLS_PER_RUN=30
AI_COOLDOWN_BASE_SECONDS=30
AI_COOLDOWN_MAX_SECONDS=1800

# Database Configuration (PostgreSQL in Docker, SQLite fallback locally)
POSTGRES_USER=jobsearch
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=jobsearch_db
DATABASE_URL=postgresql+psycopg2://jobsearch:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@localhost:5432/jobsearch_db

# Message Broker (RabbitMQ / Apache Kafka)
MESSAGE_BROKER=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=autohunt
RABBITMQ_PASSWORD=autohunt_rabbit_pass
RABBITMQ_EXCHANGE=autohunt_notifications
RABBITMQ_QUEUE=autohunt_notifications_queue
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=autohunt_notifications

# Instant Notifications (Optional — Telegram alerts to your phone)
EMAIL_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=

# Job Search & Board Discovery
MIN_MATCH_SCORE=65
MIN_VISA_CONFIDENCE=false
RESULTS_WANTED_PER_QUERY=20
HOURS_OLD=120
SCRAPE_WORKERS=4
SCRAPE_SITES=linkedin,indeed,glassdoor,google,zip_recruiter,bayt
PUBLIC_FEED_SOURCES=remoteok,jobicy,arbeitnow,arbeitnow_uk,himalayas,weworkremotely,himalayas_rss
PUBLIC_FEED_LIMIT=120
LINKEDIN_FETCH_DESCRIPTION=false
EVALUATION_BACKLOG_LIMIT_PER_RUN=30
CLAUDE_PREFILTER_ENABLED=false
MAX_CLAUDE_CALLS_PER_RUN=30
MAX_CLAUDE_CALLS_PER_DAY=150
VISA_SIGNAL_KEYWORDS=visa sponsorship,visa sponsor,sponsor visa,work permit,work authorization,relocation,relocation package,relocation support,immigration,eu blue card,skilled worker,visa support,sponsorship available,global mobility
ALERT_ON_ZERO_SCRAPE=true
MIN_EXPECTED_SCRAPE_RESULTS=1

# Automated Applications & Routing
AUTO_APPLY_MODE=send
AUTO_APPLY_WEB_ENABLED=true
AUTO_APPLY_KNOWN_ATS_ONLY=true
AUTO_APPLY_MIN_SCORE=75
AUTO_APPLY_REQUIRE_VISA_OR_REMOTE=false
AUTO_APPLY_ALLOW_MISSING_RESUME=false
ALLOW_PERSONAL_APPLICATION_RECIPIENT_DOMAINS=false
CANDIDATE_PHONE=
CANDIDATE_LINKEDIN_URL=
CANDIDATE_GITHUB_URL=
CANDIDATE_PORTFOLIO_URL=
CANDIDATE_RESUME_PATH=/app/candidate_data/resume.pdf
CANDIDATE_COVER_LETTER_PATH=
APPLY_PAGE_TIMEOUT_SECONDS=40
APPLY_HEADLESS=true
APPLY_SCREENSHOT_DIR=/app/outreach_drafts/application_screenshots
PLAYWRIGHT_WS_ENDPOINT=ws://localhost:3000/

# Email Outreach & Inbox Tracker (Optional)
OUTBOUND_SEND_ENABLED=false
SENDER_EMAIL=
SENDER_SMTP_HOST=smtp.gmail.com
SENDER_SMTP_PORT=587
SENDER_SMTP_PASSWORD=
SENDER_DISPLAY_NAME=Hamza Oukhouya
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
INBOX_POLL_MINUTES=15
FOLLOW_UP_AFTER_DAYS=7
MAX_FOLLOW_UPS=2
AUTO_REPLY_MODE=draft
AUTO_NEGOTIATE_MODE=draft

# Candidate & Dashboard Authentication
CANDIDATE_TIMEZONE=Africa/Casablanca
AVAILABILITY_NOTES=Weekdays 14:00-19:00 and weekends, Morocco time (GMT+1); flexible for early-morning CET/GST calls with notice.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DASHBOARD_PASSWORD
APP_ENVIRONMENT=production
STARTUP_REQUIRE_DASHBOARD_PASSWORD=true
PIPELINE_INTERVAL_HOURS=3

# External-Send Safety Guardrails
MAX_OUTBOUND_EMAILS_PER_DAY=5
MAX_OUTBOUND_EMAILS_PER_HOUR=2
MIN_SECONDS_BETWEEN_EXTERNAL_EMAILS=900
OUTBOUND_MIN_BODY_CHARS=120
OUTBOUND_MAX_URLS=2
OUTBOUND_MAX_EXCLAMATION_MARKS=2
OUTBOUND_SEND_KILL_SWITCH=false
MAX_APPLICATIONS_PER_DAY=15

# =============================================================================
# Freelance Client Acquisition Engine & Smart Follow-Up Cadence
# =============================================================================
FREELANCE_ENABLED=true
FREELANCE_DISCOVERY_SOURCES=hackernews,reddit,remoteok,jobicy,weworkremotely,google
FREELANCE_MAX_LEADS_PER_SCAN=100
FREELANCE_MIN_SCORE=60
FREELANCE_AUTO_PITCH=false
FREELANCE_MAX_PITCHES_PER_DAY=5
FREELANCE_FOLLOW_UP_1_DAYS=3
FREELANCE_FOLLOW_UP_2_DAYS=7
FREELANCE_MAX_FOLLOW_UPS=2
FREELANCE_HOURLY_RATE_USD=50
FREELANCE_DAILY_RATE_EUR=400
FREELANCE_PREFERRED_CURRENCY=EUR
CALENDAR_BOOKING_URL=  # Optional free booking link: e.g. https://cal.com/your-name
