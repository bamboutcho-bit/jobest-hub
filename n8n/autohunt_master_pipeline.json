        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event\": \"n8n_sync_completed\",\n  \"data\": {\n    \"matches_found\": {{ $('Rank & Format Deal Intelligence').first().json.count }},\n    \"interviews_found\": {{ $('Rank & Format Deal Intelligence').first().json.interview_count }},\n    \"top_job\": \"{{ $('Rank & Format Deal Intelligence').first().json.top_job }}\",\n    \"top_score\": {{ $('Rank & Format Deal Intelligence').first().json.top_score }},\n    \"synced_at\": \"{{ $now.toISO() }}\"\n  }\n}",
        "options": {}
      },
