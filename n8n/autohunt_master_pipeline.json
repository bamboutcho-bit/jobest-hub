    {
      "parameters": {
        "jsCode": "// Prepare individual rows for Google Sheets / Notion / Airtable CRM Sync\nconst matches = $input.first().json.all_matches || [];\nreturn matches.map(m => ({\n  json: {\n    Job_ID: m.id,\n    Rank: m.rank,\n    Title: m.title,\n    Company: m.company,\n    Location: m.location,\n    Match_Score: m.score,\n    Tier: m.tier,\n    Visa_Status: m.visa,\n    Pipeline_Stage: m.stage,\n    Application_URL: m.url,\n    Date_Scraped: m.scraped_at,\n    Exported_At: new Date().toISOString()\n  }\n}));"
      },
