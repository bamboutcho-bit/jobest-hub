      "id": "e22934b1-b4f0-4660-8431-000000000005",
      "name": "Fetch Top Matches & Scheduled Interviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "// Process and rank incoming match data & interviews\nconst inputData = $input.first().json;\nconst matches = inputData.matches || [];\nconst interviews = inputData.interviews || [];\nconst hasInterviews = Boolean(inputData.has_interviews && interviews.length > 0);\nconst tgConfigured = Boolean(inputData.telegram_configured);\nconst tgToken = inputData.telegram_bot_token || '';\nconst tgChatId = inputData.telegram_chat_id || '';\n\n// 1. Format Interview Alert Digest (Only sent if an interview is scheduled/requested)\nlet interviewAlertText = '';\nif (hasInterviews) {\n  const interviewCards = interviews.map(i => {\n    const stageTitle = i.stage === 'interview_scheduled' ? '🗓️ INTERVIEW CONFIRMED' : '📩 INTERVIEW REQUEST RECEIVED';\n    const notesText = i.interview_notes || i.notes ? `\\n📝 *Notes:* ${i.interview_notes || i.notes}` : '';\n    const applyUrl = i.application_url || 'http://localhost:8080/app#inbox';\n    return `🎉 *${stageTitle}* 🚀\\n\\n` +\n      `💼 *Company:* *${i.company}*\\n` +\n      `🎯 *Role:* *${i.title}*\\n` +\n      (i.location ? `📍 *Location:* ${i.location}\\n` : '') +\n      notesText + `\\n` +\n      `🔗 *AutoHunt Inbox:* ${applyUrl}`;\n  });\n  interviewAlertText = interviewCards.join('\\n\\n━━━━━━━━━━━━━━━━━━━━\\n\\n');\n}\n\n// 2. Process CRM Rows\nmatches.sort((a, b) => (b.score || 0) - (a.score || 0));\nconst enriched = matches.map((job, idx) => {\n  const score = job.score || 0;\n  let tier = '💼 Tier 3 (Good Fit)';\n  let badge = '⭐';\n  if (score >= 90) {\n    tier = '🦄 Tier 1 (Unicorn Fit)';\n    badge = '🚀';\n  } else if (score >= 80) {\n    tier = '🎯 Tier 2 (High Fit)';\n    badge = '🎯';\n  }\n\n  const appUrl = job.application_url || job.job_url || 'https://linkedin.com';\n  const visaText = job.visa_category ? ` | 🛂 Visa: ${job.visa_category}` : '';\n\n  return {\n    rank: idx + 1,\n    id: job.id,\n    title: job.title,\n    company: job.company,\n    location: job.location,\n    score: score,\n    tier: tier,\n    badge: badge,\n    visa: job.visa_category || 'Standard',\n    stage: job.stage || 'evaluated',\n    url: appUrl,\n    scraped_at: job.scraped_at,\n    summary_line: `${badge} [${score}%] *${job.title}* at *${job.company}* (${job.location}${visaText})\\n🔗 Apply: ${appUrl}`\n  };\n});\n\nreturn [{\n  json: {\n    has_matches: enriched.length > 0,\n    count: enriched.length,\n    top_score: enriched[0] ? enriched[0].score : 0,\n    top_job: enriched[0] ? `${enriched[0].title} at ${enriched[0].company}` : 'None',\n    has_interviews: hasInterviews,\n    interview_count: interviews.length,\n    interview_digest: interviewAlertText,\n    interviews: interviews,\n    telegram_configured: tgConfigured,\n    telegram_bot_token: tgToken,\n    telegram_chat_id: tgChatId,\n    all_matches: enriched\n  }\n}];"
      },
      "id": "e22934b1-b4f0-4660-8431-000000000006",
      "name": "Rank & Format Deal Intelligence",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        280
      ]
    },
