          "conditions": [
            {
              "id": "c3",
              "leftValue": "={{ $json.telegram_configured }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "c4",
              "leftValue": "={{ $json.has_interviews }}",
              "rightValue": true,
              "operator": {
